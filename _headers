# Cloudflare Pages header rules.
#
# Keep the *.pages.dev deployment host out of search results — the canonical
# host is learnaboutchina.org, declared by rel=canonical on every page, so the
# pages.dev copy must not be indexed as a duplicate.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

# Cloudflare Pages already sends Referrer-Policy: strict-origin-when-cross-origin
# and X-Content-Type-Options: nosniff by default; clickjacking protection is not
# included, so it is added here.
/*
  X-Frame-Options: SAMEORIGIN
